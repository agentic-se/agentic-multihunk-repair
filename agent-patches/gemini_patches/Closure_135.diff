+        // Handle the case where a prototype is assigned a new instance of a superclass.
+        if (rhsValue != null && rhsValue.getType() == Token.NEW) {
+          Node constructorNode = rhsValue.getFirstChild();
+          JSType constructorType = constructorNode.getJSType();
+          if (constructorType instanceof FunctionType) {
+            FunctionType superCtor = (FunctionType) constructorType;
+            if (superCtor.isConstructor()) {
+              // Get the constructor whose prototype is being assigned (e.g., Sub in Sub.prototype = new Super())
+              Var ctorVar = scope.getVar(ownerName);
+              if (ctorVar != null && ctorVar.getType() instanceof FunctionType) {
+                FunctionType subCtor = (FunctionType) ctorVar.getType();
+                if (subCtor.isConstructor()) {
+                  subCtor.setPrototypeBasedOn(superCtor);
+                }
+              }
+            }
+          }
+        }
