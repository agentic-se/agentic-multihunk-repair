+  private class ProcessCommonJsModulesCallback extends
+      AbstractPostOrderCallback {
+
+    private int scriptNodeCount = 0;
+    private Node moduleExportsAssignmentValue = null;
+
+    @Override
+    public void visit(NodeTraversal t, Node n, Node parent) {
+      if (n.isCall() && n.getChildCount() == 2 &&
+          "require".equals(n.getFirstChild().getQualifiedName()) &&
+          n.getChildAtIndex(1).isString()) {
+        visitRequireCall(t, n, parent);
+      }
+
+      if (n.isScript()) {
+        scriptNodeCount++;
+        visitScript(t, n);
+      }
+
+      if (n.isGetProp() &&
+          "module.exports".equals(n.getQualifiedName())) {
+        visitModuleExports(n);
+      }
+
+      if (n.isAssign() && n.getFirstChild().isGetProp() &&
+          "module.exports".equals(n.getFirstChild().getQualifiedName())) {
+        moduleExportsAssignmentValue = n.getLastChild().detachFromParent();
+        parent.removeChild(n);
+        compiler.reportCodeChange();
+      }
+    }
