+  private void test(CompilerOptions options,
+      String[] original, String[] compiled, DiagnosticType[] warnings) {
+    Compiler compiler = compile(options, original);
+    
+    System.err.println("\n--- Debugging testIncompleteFunction ---");
+    System.err.println("Actual Errors: " + compiler.getErrors().length);
+    for (JSError error : compiler.getErrors()) {
+      System.err.println("  Error: " + error.toString());
+    }
+    System.err.println("Actual Warnings: " + compiler.getWarnings().length);
+    for (JSError warning : compiler.getWarnings()) {
+      System.err.println("  Warning: " + warning.toString());
+    }
+
+    checkUnexpectedErrorsOrWarnings(compiler, warnings.length);
+
+    if (compiled != null) {
+      Node root = compiler.getRoot().getLastChild();
+      Node expectedRoot = parse(compiled, options);
+      System.err.println("Expected Output: " + compiler.toSource(expectedRoot));
+      System.err.println("Actual Output:   " + compiler.toSource(root));
+      String explanation = expectedRoot.checkTreeEquals(root);
+      assertNull("\nExpected: " + compiler.toSource(expectedRoot) +
+          "\nResult: " + compiler.toSource(root) +
+          "\n" + explanation, explanation);
+    }
+    System.err.println("--- End Debugging ---");
+  }
