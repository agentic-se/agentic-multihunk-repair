+      if (NodeUtil.isGetProp(name) || NodeUtil.isName(name)) {
+        Collection<Definition> decls =
+            definitionProvider.getDefinitionsReferencedAt(name);
+        if (decls == null) {
+          return null;
+        }
+
+        for (Definition current : decls) {
+          Node rValue = current.getRValue();
+          if ((rValue != null) && NodeUtil.isFunction(rValue)) {
+            result.add(current);
+          } else {
+            return null;
+          }
+        }
+      } else if (name.getType() == Token.OR) {
+        Collection<Definition> first = getCallableDefinitions(definitionProvider, name.getFirstChild());
+        Collection<Definition> second = getCallableDefinitions(definitionProvider, name.getLastChild());
+
+        if (first == null || second == null) {
+          return null;
+        }
+
+        result.addAll(first);
+        result.addAll(second);
+      } else if (name.getType() == Token.HOOK) {
+        // The HOOK operator has three children: condition, true_case, false_case.
+        // We are interested in the true_case and false_case for callable definitions.
+        Collection<Definition> trueCase = getCallableDefinitions(definitionProvider, name.getFirstChild().getNext());
+        Collection<Definition> falseCase = getCallableDefinitions(definitionProvider, name.getLastChild());
+
+        if (trueCase == null || falseCase == null) {
+          return null;
+        }
+
+        result.addAll(trueCase);
+        result.addAll(falseCase);
+      } else {
+        return null;
+      }
+
+      return result;
