+    public double cumulativeProbability(int x) {
+        double ret;
+        if (x < 0) {
+            ret = 0.0;
+        } else if (x >= numberOfTrials) {
+            ret = 1.0;
+        } else {
+            // For large number of trials, use normal approximation
+            if (numberOfTrials > 100000) { // Threshold for normal approximation
+                double mean = getNumericalMean();
+                double standardDeviation = FastMath.sqrt(getNumericalVariance());
+                NormalDistribution normal = new NormalDistribution(mean, standardDeviation);
+                // Apply continuity correction: P(X <= x) approx P(Y <= x + 0.5)
+                ret = normal.cumulativeProbability(x + 0.5);
+            } else {
+                double betaReg = Beta.regularizedBeta(probabilityOfSuccess, x + 1.0, numberOfTrials - x);
+
+                // Handle potential numerical issues from Beta.regularizedBeta
+                if (Double.isNaN(betaReg)) {
+                    if (x < getNumericalMean()) {
+                        betaReg = 0.0;
+                    } else {
+                        betaReg = 1.0;
+                    }
+                } else if (Double.isInfinite(betaReg)) {
+                    if (betaReg > 0) { // Positive infinity
+                        betaReg = 1.0;
+                    } else { // Negative infinity
+                        betaReg = 0.0;
+                    }
+                }
+
+                // Ensure betaReg is within [0, 1] after handling infinities/NaNs
+                if (betaReg < 0.0) {
+                    betaReg = 0.0;
+                } else if (betaReg > 1.0) {
+                    betaReg = 1.0;
+                }
+
+                ret = 1.0 - betaReg;
+            }
+        }
+        return ret;
+    }
