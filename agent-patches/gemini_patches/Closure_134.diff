-
-      return null;
+      // First, check to see if the property is implemented
+      // on a superclass.
+      JSType propType = ownerType.getPropertyType(propName);
+      if (propType instanceof FunctionType) {
+        return (FunctionType) propType;
+      }
+
+      // If it's not, then check to see if it's implemented
+      // on an implemented interface.
+      if (ownerType.isConstructor()) {
+        for (JSType implementedInterface :
+             ownerType.getConstructor().getImplementedInterfaces()) {
+          propType = implementedInterface.getPropertyType(propName);
+          if (propType instanceof FunctionType) {
+            return (FunctionType) propType;
+          }
+        }
+      }
+
+      return null;
@@ -1,1 +1,2 @@
-          propType = implementedInterface.getPropertyType(propName);
+          ObjectType interfaceObjType = implementedInterface.toObjectType();
+          propType = interfaceObjType.getPropertyType(propName);

