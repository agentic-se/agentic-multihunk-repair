+  // Helper method to fold NOT nodes to boolean literals
+  private Node foldNotToBooleanLiteral(Node n) {
+    if (n.getType() == Token.NOT) {
+      Node child = n.getFirstChild();
+      if (NodeUtil.isLiteralValue(child, false)) {
+        TernaryValue childVal = NodeUtil.getPureBooleanValue(child);
+        if (childVal != TernaryValue.UNKNOWN) {
+          return new Node(childVal.toBoolean(true) ? Token.FALSE : Token.TRUE);
+        }
+      }
+    }
+    return n;
+  }
