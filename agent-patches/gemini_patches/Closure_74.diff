+  private Node tryFoldComparison(Node n, Node left, Node right) {
+    // Try to fold NOT nodes to boolean literals
+    Node newLeft = foldNotToBooleanLiteral(left);
+    if (newLeft != left) {
+      n.replaceChild(left, newLeft);
+      left = newLeft;
+      reportCodeChange();
+    }
+
+    Node newRight = foldNotToBooleanLiteral(right);
