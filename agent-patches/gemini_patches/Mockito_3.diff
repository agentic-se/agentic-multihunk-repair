+    public void captureArgumentsFrom(Invocation invocation) {
+        Method method = invocation.getMethod();
+        Object[] arguments = invocation.getArguments(); // Expanded varargs
+
+        for (int position = 0; position < matchers.size(); position++) {
+            Matcher m = matchers.get(position);
+            if (m instanceof CapturesArguments) {
+                if (position < arguments.length) { // Ensure we don't go out of bounds
+                    if (method.isVarArgs() && position == method.getParameterTypes().length - 1) {
+                        // This matcher is at the vararg parameter index, capture all remaining arguments
+                        for (int i = position; i < arguments.length; i++) {
+                            ((CapturesArguments) m).captureFrom(invocation.getArgumentAt(i, Object.class));
+                        }
+                        break; // All vararg elements captured by this matcher
+                    } else {
+                        // Capture a single argument
+                        ((CapturesArguments) m).captureFrom(invocation.getArgumentAt(position, Object.class));
+                    }
