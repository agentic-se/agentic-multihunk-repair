+    public void captureArgumentsFrom(Invocation invocation) {
+        if (invocation.getMethod().isVarArgs()) {
+            int varargIndex = invocation.getMethod().getParameterTypes().length - 1;
+
+            // Capture regular arguments before vararg
+            for (int position = 0; position < varargIndex; position++) {
+                Matcher m = matchers.get(position);
+                if (m instanceof CapturesArguments) {
+                    ((CapturesArguments) m).captureFrom(invocation.getArgumentAt(position, Object.class));
+                }
+            }
+
+            // Capture vararg elements
+            if (varargIndex < matchers.size()) {
+                Matcher varargMatcher = matchers.get(varargIndex);
+                if (varargMatcher instanceof CapturesArguments) {
+                    Object varargArray = invocation.getRawArguments()[varargIndex];
+                    if (varargArray != null) {
+                        for (int i = 0; i < Array.getLength(varargArray); i++) {
+                            ((CapturesArguments) varargMatcher).captureFrom(Array.get(varargArray, i));
+                        }
+                    }
+                }
+            }
+        } else {
+            // Existing logic for non-vararg methods
+            for (int position = 0; position < matchers.size(); position++) {
+                Matcher m = matchers.get(position);
+                if (m instanceof CapturesArguments) {
