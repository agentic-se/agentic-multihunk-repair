+    public JsonProperty.Access findAccess() {
+        // 16-Aug-2016, tatu: Need to check all members, not just primary,
+        //   to find if there's explicit setting.
+        //   Also, for deserialization, need to consider fields and setters
+        //   as primary, for serialization getters and fields.
+        //   But for access, any explicit annotation should take precedence.
+        JsonProperty.Access acc = fromMemberAnnotationsExcept(new WithMember<JsonProperty.Access>() {
+            @Override
+            public JsonProperty.Access withMember(AnnotatedMember member) {
+                return _annotationIntrospector.findPropertyAccess(member);
+            }
+        }, JsonProperty.Access.AUTO);
+        if (acc != null && acc != JsonProperty.Access.AUTO) {
+            return acc;
+        }
+        // If not explicitly defined, let's see if we can infer from mutators/accessors
+        // For deserialization, if there's a setter or field, it's at least WRITE_ONLY
+        if (!_forSerialization) {
+            if (hasSetter() || hasField() || hasConstructorParameter()) {
+                return JsonProperty.Access.WRITE_ONLY;
+            }
+        }
+        // For serialization, if there's a getter or field, it's at least READ_ONLY
+        if (_forSerialization) {
+            if (hasGetter() || hasField()) {
+                return JsonProperty.Access.READ_ONLY;
+            }
+        }
+        return JsonProperty.Access.AUTO;
+    }
