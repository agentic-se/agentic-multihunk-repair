+    @Override
+    public void enterScope(NodeTraversal t) {
+      Node n = t.getCurrentNode().getParent();
+      if (n != null && isCallToScopeMethod(n)) {
+        transformation = transformationHandler.logAliasTransformation(
+            n.getSourceFileName(), getSourceRegion(n));
+      }
+    }
+
+    @Override
+    public void exitScope(NodeTraversal t) {
+      if (t.getScopeDepth() == 2) {
+        // Process collected JSDoc type nodes
+        for (Node typeNode : jsDocTypeNodesToProcess) {
+          fixTypeNode(typeNode);
+        }
+        jsDocTypeNodesToProcess.clear();
+
+        // Process collected alias reference nodes
+        for (Node aliasReference : aliasReferenceNodesToProcess) {
+          String name = aliasReference.getString();
+          Var aliasVar = aliases.get(name);
+          if (aliasVar != null && t.getScope().getVar(name) == aliasVar) {
+            Node aliasedNode = aliasVar.getInitialValue();
+            aliasUsages.add(new AliasedNode(aliasReference, aliasedNode));
+          }
+        }
+        aliasReferenceNodesToProcess.clear();
+
+        aliases.clear();
+        transformation = null;
+      }
+    }
