+    @Override
+    public JsonToken nextToken() throws IOException, JsonParseException
+    {
+        if (_hasToken) {
+            _hasToken = false;
+            return delegate.getCurrentToken();
+        }
+        JsonToken t = delegate.nextToken();
+        if (t != null) return t;
+        while (switchToNext()) {
+            if (delegate.hasCurrentToken()) {
+                return delegate.getCurrentToken();
+            }
+            t = delegate.nextToken();
+            if (t != null) return t;
+        }
