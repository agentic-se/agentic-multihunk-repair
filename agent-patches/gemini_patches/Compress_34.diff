+    public void parseFromLocalFileData(
+            byte[] data, int offset, int length
+    ) throws ZipException {
+        reset();
+        if (length < 1) { // Need at least 1 byte for version
+            return;
+        }
+        this.version = signedByteToUnsignedInt(data[offset++]);
+        length--;
+
+        if (length < 1) { // Need at least 1 byte for uidSize
+            return;
+        }
+        int uidSize = signedByteToUnsignedInt(data[offset++]);
+        length--;
+
+        if (length < uidSize) { // Need uidSize bytes for UID
+            throw new ZipException("X7875_NewUnix local file data is too short. Expected " + uidSize + " bytes for UID, got " + length);
+        }
+        byte[] uidBytes = new byte[uidSize];
+        System.arraycopy(data, offset, uidBytes, 0, uidSize);
+        offset += uidSize;
+        length -= uidSize;
+        this.uid = new BigInteger(1, reverse(uidBytes)); // sign-bit forced positive
+
+        if (length < 1) { // Need at least 1 byte for gidSize
+            return;
+        }
+        int gidSize = signedByteToUnsignedInt(data[offset++]);
+        length--;
+
+        if (length < gidSize) { // Need gidSize bytes for GID
+            throw new ZipException("X7875_NewUnix local file data is too short. Expected " + gidSize + " bytes for GID, got " + length);
+        }
+        byte[] gidBytes = new byte[gidSize];
+        System.arraycopy(data, offset, gidBytes, 0, gidSize);
+        this.gid = new BigInteger(1, reverse(gidBytes)); // sign-bit forced positive
+    }
