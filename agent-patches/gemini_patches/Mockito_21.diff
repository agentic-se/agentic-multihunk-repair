+    private <T> T withOuterClass(Class<T> cls) {
+        try {
+            Class<?> enclosingClass = cls.getEnclosingClass();
+            if (enclosingClass != null && enclosingClass.isInstance(outerClassInstance)) {
+                Constructor<T> c = cls.getDeclaredConstructor(enclosingClass);
+                return c.newInstance(outerClassInstance);
+            } else {
+                // Fallback to original behavior if enclosing class is not found or outer instance is not compatible
+                Constructor<T> c = cls.getDeclaredConstructor(outerClassInstance.getClass());
+                return c.newInstance(outerClassInstance);
+            }
+        } catch (Exception e) {
+            throw paramsException(cls, e);
+        }
+    }

