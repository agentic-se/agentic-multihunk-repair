+    private static long convertByYear(long instant, Chronology from, Chronology to) {
+        int year = from.year().get(instant);
+        if (from == GregorianChronology.getInstanceUTC() && to == JulianChronology.getInstanceUTC()) {
+            if (year <= 0) {
+                year--;
+            }
+        } else if (from == JulianChronology.getInstanceUTC() && to == GregorianChronology.getInstanceUTC()) {
+            if (year < 0) {
+                year++;
+            }
+        }
+        return to.getDateTimeMillis
+            (year,
+             from.monthOfYear().get(instant),
+             from.dayOfMonth().get(instant),
+             from.millisOfDay().get(instant));
+    }
