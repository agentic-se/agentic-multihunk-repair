+  void expectArgumentMatchesParameter(NodeTraversal t, Node n, JSType argType,
+      JSType paramType, Node callNode, int ordinal) {
+    // Special case for function return types: if the formal parameter's
+    // return type is '?', and the actual parameter's return type is 'undefined',
+    // consider them compatible.
+    if (argType.isFunctionType() && paramType.isFunctionType()) {
+      FunctionType actualFnType = argType.toMaybeFunctionType();
+      FunctionType formalFnType = paramType.toMaybeFunctionType();
+
+      if (actualFnType != null && formalFnType != null &&
+          actualFnType.getReturnType().isVoidType() &&
+          formalFnType.getReturnType().isUnknownType()) {
+        // If the actual return type is undefined and the formal is unknown,
+        // consider it a match for the return type part.
+        // Now, we still need to check the parameters.
+        // We'll create a temporary function type with the formal return type
+        // to allow the rest of the comparison to proceed.
+        FunctionType tempActualFnType = typeRegistry.createFunctionTypeWithNewReturnType(
+            actualFnType, formalFnType.getReturnType());
+
+        if (tempActualFnType.canAssignTo(formalFnType)) {
+          return; // Parameters also match, so no error.
+        }
+      }
+    }
+
+    if (!argType.canAssignTo(paramType)) {
+      mismatch(t, n,
+          String.format("actual parameter %d of %s does not match " +
+              "formal parameter", ordinal,
+              getReadableJSTypeName(callNode.getFirstChild(), false)),
+          argType, paramType);
+    }
+  }
