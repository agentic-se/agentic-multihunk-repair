+      // Compute rho = (v1 . v2) / ||v2||^2
+      final double dot = x1 * x2 + y1 * y2 + z1 * z2;
+      final double normSq_v2 = x2 * x2 + y2 * y2 + z2 * z2;
+
+      if (normSq_v2 == 0.0) {
+          // If v2 is a zero vector, the cross product is zero.
+          return ZERO;
