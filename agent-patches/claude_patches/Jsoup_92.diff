@@ -394,6 +395,27 @@ public class Attributes implements Iterable<Attribute>, Cloneable {
      * @param settings case sensitivity
      * @return number of removed dupes
      */
+    public int deduplicate(ParseSettings settings) {
+        if (isEmpty())
+            return 0;
+        // We want to keep the first occurrence of each attribute and remove later duplicates
+        int dupes = 0;
+        // For each attribute, check if there's a duplicate later in the list
+        for (int i = 0; i < size; i++) {
+            for (int j = i + 1; j < size; j++) {
+                if (keys[i].equals(keys[j])) { // case-sensitive check (keys are already normalized by now)
+                    remove(j);
+                    dupes++;
+                    j--; // recheck this position as we just shifted everything down
+                }
+            }
+        }
+        return dupes;
+    }
+
+    private boolean isEmpty() {
+        return size == 0;
+    }
 
