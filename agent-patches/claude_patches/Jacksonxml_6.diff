+    /**
+     * Helper method to read all data from InputStream into a byte array.
+     */
+    private byte[] _readAll(InputStream in, int expectedLength) throws IOException
+    {
+        // If length is known and reasonable, allocate exact size
+        if (expectedLength > 0) {
+            byte[] buffer = new byte[expectedLength];
+            int offset = 0;
+            int remaining = expectedLength;
+            while (remaining > 0) {
+                int count = in.read(buffer, offset, remaining);
+                if (count < 0) {
+                    break;
+                }
+                offset += count;
+                remaining -= count;
+            }
+            if (offset == expectedLength) {
+                return buffer;
+            }
+            // Fewer bytes read than expected, need to trim
+            byte[] result = new byte[offset];
+            if (offset > 0) {
+                System.arraycopy(buffer, 0, result, 0, offset);
+            }
+            return result;
+        }
+        // Length unknown or negative, use ByteArrayOutputStream
+        java.io.ByteArrayOutputStream bytes = new java.io.ByteArrayOutputStream(4000);
+        byte[] buffer = new byte[4000];
+        int count;
+        while ((count = in.read(buffer)) >= 0) {
+            bytes.write(buffer, 0, count);
+        }
+        return bytes.toByteArray();
+    }
+
+    /**
+     * Helper method to write binary data from InputStream to the XML writer.
+     */
+    private int _writeBinary(XMLStreamWriter2 writer, InputStream data, int dataLength)
+            throws IOException, XMLStreamException
+    {
+        // Read and write in chunks to save memory
+        byte[] buffer = new byte[4000];
+        int totalRead = 0;
+        int count;
+
+        while ((count = data.read(buffer)) >= 0) {
+            writer.writeBinary(buffer, 0, count);
