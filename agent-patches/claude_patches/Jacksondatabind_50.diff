+    private static class PropertyReferring extends Referring {
+        private final Forward _parent;
+        private final Object _pojo;
+
+        public PropertyReferring(Forward parent, UnresolvedForwardReference ref, Class<?> type, Object ob)
+        {
+            super(ref, type);
+            _parent = parent;
+            _pojo = ob;
+        }
+
+        @Override
+        public void handleResolvedForwardReference(Object id, Object value) throws IOException
