+    /**
+     * Checks if the given node is a property key in an object literal
+     * that is being assigned to a prototype.
+     * e.g., for "Foo.prototype = {bar: ...}", when n is the "bar" key node
+     */
+    private boolean isPrototypePropertyInObjectLiteral(Node n, Node parent) {
+      if (parent != null && parent.isObjectLit()) {
+        Node objectLiteral = parent;
+        Node gramps = objectLiteral.getParent();
+        if (gramps != null && gramps.isAssign()) {
+          Node assignTarget = gramps.getFirstChild();
+          if (assignTarget.isGetProp() &&
+              assignTarget.getLastChild().getString().equals("prototype")) {
+            // This is a property in an object literal assigned to a prototype
+            return n.isString() || n.isGetterDef() || n.isSetterDef();
+          }
+        }
+      }
+      return false;
+    }
+
+    /**
+     * Checks if the given ASSIGN node assigns to a prototype of a global variable.
+     * e.g., for "Foo.prototype = {...}", checks if Foo is a global variable
+     */
+    private boolean isPrototypeOfGlobalVar(Node assignNode, NodeTraversal t) {
+      if (assignNode != null && assignNode.isAssign()) {
+        Node assignTarget = assignNode.getFirstChild();
+        if (assignTarget.isGetProp() &&
+            assignTarget.getLastChild().getString().equals("prototype")) {
+          Node objectNode = assignTarget.getFirstChild();
+          if (objectNode.isName()) {
+            String varName = objectNode.getString();
+            Var var = t.getScope().getVar(varName);
+            return var != null && var.isGlobal();
+          }
+        }
+      }
+      return false;
+    }
