+  /**
+   * Rename all labels in the given node tree to make them unique.
+   */
+  private void makeLabelNamesUnique(Node fnNode, Supplier<String> labelSupplier) {
+    renameLabelNodes(fnNode, labelSupplier, fnNode);
+  }
+
+  /**
+   * Recursively rename all LABEL nodes in the tree.
+   */
+  private void renameLabelNodes(Node node, Supplier<String> labelSupplier, Node fnNode) {
+    if (node.getType() == Token.LABEL) {
+      // Rename the label
+      Node labelNameNode = node.getFirstChild();
+      String newName = labelSupplier.get();
+      labelNameNode.setString(newName);
+    }
+
+    // Don't traverse into nested functions
+    if (node.getType() != Token.FUNCTION || node == fnNode) {
+      for (Node child = node.getFirstChild(); child != null; child = child.getNext()) {
+        renameLabelNodes(child, labelSupplier, fnNode);
+      }
+    }
   }
 
