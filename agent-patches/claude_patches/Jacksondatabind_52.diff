+        public ExternalTypeHandler build(BeanPropertyMap props, SettableBeanProperty[] creatorProps) {
             // 21-Jun-2016, tatu: as per [databind#999], may need to link type id property also
+            for (ExtTypedProperty extProp : _properties) {
+                String typePropertyName = extProp.getTypePropertyName();
+                SettableBeanProperty typeProp = props.find(typePropertyName);
+                // if not found in regular properties, check creator properties
+                if (typeProp == null && creatorProps != null) {
+                    for (SettableBeanProperty creatorProp : creatorProps) {
+                        if (typePropertyName.equals(creatorProp.getName())) {
+                            typeProp = creatorProp;
+                            break;
+                        }
+                    }
+                }
+                if (typeProp != null) {
+                    extProp.linkTypeProperty(typeProp);
+                }
+            }
+            return new ExternalTypeHandler(_properties.toArray(new ExtTypedProperty[_properties.size()]),
+                    _nameToPropertyIndex, null, null);
