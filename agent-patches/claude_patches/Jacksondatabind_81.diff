+    /**
+     * Helper method to check if two classes form a primitive/wrapper pair.
+     * Used to handle type refinements as per [databind#1592].
+     *
+     * @since 2.9
+     */
+    protected boolean _primitiveAndWrapper(Class<?> type1, Class<?> type2)
+    {
+        if (type1.isPrimitive()) {
+            return ClassUtil.wrapperType(type1) == type2;
+        }
+        if (type2.isPrimitive()) {
+            return ClassUtil.wrapperType(type2) == type1;
+        }
+        // Neither is primitive; check if one is a wrapper and the other its primitive
+        // by checking if either has a primitive equivalent that matches the other
+        Class<?> prim1 = ClassUtil.primitiveType(type1);
+        if (prim1 != null) {
+            return prim1 == type2;
+        }
+        Class<?> prim2 = ClassUtil.primitiveType(type2);
+        if (prim2 != null) {
+            return prim2 == type1;
+        }
+        return false;
+    }
 
