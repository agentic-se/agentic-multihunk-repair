@@ -394,6 +395,26 @@ public class Attributes implements Iterable<Attribute>, Cloneable {
      * @param settings case sensitivity
      * @return number of removed dupes
      */
+    public int deduplicate() {
+        // Remove duplicate attributes by exact key match, preserving the first occurrence.
+        // Typical attribute lists are small, so a HashSet-based approach is fine.
+        int removed = 0;
+        if (size <= 1) return 0;
+
+        HashSet<String> seen = new HashSet<>(size * 2);
+        int i = 0;
+        while (i < size) {
+            String key = keys[i];
+            if (seen.contains(key)) {
+                remove(i); // don't increment i; next item is now at position i
+                removed++;
+            } else {
+                seen.add(key);
+                i++;
+            }
+        }
+        return removed;
+    }
 
