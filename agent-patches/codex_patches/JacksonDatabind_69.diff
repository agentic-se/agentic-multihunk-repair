         // can be null if annotation processing is disabled...
         if (_annotationIntrospector != null) {
+            // First, detect if there are any explicitly annotated (@JsonCreator) constructors
+            // or factory methods. If there are, prefer them and skip collecting
+            // parameters from other non-annotated creators to avoid conflicts where
+            // multiple constructors define @JsonProperty parameters.
+            boolean hasAnnotatedCtors = false;
+            for (AnnotatedConstructor c : _classDef.getConstructors()) {
+                if (_annotationIntrospector.hasCreatorAnnotation(c)) {
+                    hasAnnotatedCtors = true;
+                    break;
+                }
+            }
+            boolean hasAnnotatedFactories = false;
+            for (AnnotatedMethod m : _classDef.getStaticMethods()) {
+                if (_annotationIntrospector.hasCreatorAnnotation(m)) {
+                    hasAnnotatedFactories = true;
+                    break;
+                }
+            }
+
             for (AnnotatedConstructor ctor : _classDef.getConstructors()) {
+                // If there are explicitly annotated constructors, only include those
+                if (hasAnnotatedCtors && !_annotationIntrospector.hasCreatorAnnotation(ctor)) {
+                    continue;
+                }
                 if (_creatorProperties == null) {
                     _creatorProperties = new LinkedList<POJOPropertyBuilder>();
                 }
