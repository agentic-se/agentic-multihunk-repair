+
+        // Merge provided interfaces with any already configured ones to allow combining
+        // calls like withSettings().serializable().extraInterfaces(X) and vice versa.
+        if (this.extraInterfaces == null || this.extraInterfaces.length == 0) {
+            this.extraInterfaces = extraInterfaces;
+        } else {
+            java.util.LinkedHashSet<Class<?>> merged = new java.util.LinkedHashSet<Class<?>>(java.util.Arrays.asList(this.extraInterfaces));
+            merged.addAll(java.util.Arrays.asList(extraInterfaces));
+            this.extraInterfaces = merged.toArray(new Class<?>[merged.size()]);
+        }
+        return this;
+    }
 
