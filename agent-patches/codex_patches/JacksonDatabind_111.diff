index 9d5c3ded5..95f876b7e 100644
--- a/src/main/java/com/fasterxml/jackson/databind/deser/std/AtomicReferenceDeserializer.java
+++ b/src/main/java/com/fasterxml/jackson/databind/deser/std/AtomicReferenceDeserializer.java
@@ -40,11 +40,28 @@ public class AtomicReferenceDeserializer
 
     @Override
     public AtomicReference<Object> getNullValue(DeserializationContext ctxt) throws JsonMappingException {
+        // For reference types, null token should create a reference whose
+        // contents is the content-deserializer's null value (which may itself
+        // be a reference for nested types). If we don't yet have a content
+        // deserializer, fall back to an empty AtomicReference.
+        if (_valueDeserializer != null) {
+            Object nullValue = _valueDeserializer.getNullValue(ctxt);
+            return new AtomicReference<Object>(nullValue);
+        }
         return new AtomicReference<Object>();
     }
 
     @Override
     public Object getEmptyValue(DeserializationContext ctxt) {
+        // Keep semantics in sync with getNullValue for reference wrappers
+        if (_valueDeserializer != null) {
+            try {
+                return new AtomicReference<Object>(_valueDeserializer.getNullValue(ctxt));
+            } catch (JsonMappingException e) {
+                // If contextual null value resolution fails here, fall back
+                // to an empty AtomicReference to avoid unexpected failures.
+            }
+        }
         return new AtomicReference<Object>();
     }
     
