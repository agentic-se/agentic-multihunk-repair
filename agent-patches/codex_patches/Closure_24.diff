@@ -292,6 +292,21 @@ class ScopedAliases implements HotSwapCompilerPass {
           // TODO(robbyw): Support using locals for private variables.
           report(t, n, GOOG_SCOPE_NON_ALIAS_LOCAL, n.getString());
         }
+        } else if (parent != null && parent.isFunction()) {
+          // If this is the named function expression passed directly to
+          // goog.scope, skip reporting here. That case is handled as a
+          // bad-parameters error in validateScopeCall.
+          Node grandparent = parent.getParent();
+          boolean isScopeFunctionParam =
+              grandparent != null && grandparent.isCall() &&
+              SCOPING_METHOD_NAME.equals(
