+
+        // Basic heuristic: if value is not a 4-part dot-separated IPv4 literal, treat as hostname
+        private boolean _looksLikeHostName(String str) {
+            if (str == null || str.isEmpty()) {
+                return false;
+            }
+            String[] parts = str.split("\\.");
+            if (parts.length != 4) {
+                return true;
+            }
+            for (String p : parts) {
+                try {
+                    int v = Integer.parseInt(p);
+                    if (v < 0 || v > 255) {
+                        return true;
+                    }
+                } catch (NumberFormatException e) {
+                    return true;
+                }
+            }
+            return false;
