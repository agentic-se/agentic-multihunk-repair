+    // Detect if the evaluator tree includes a :matchText clause
+    private static boolean containsMatchText(Evaluator eval) {
+        if (eval instanceof Evaluator.MatchText) return true;
+        if (eval instanceof CombiningEvaluator.And) {
+            CombiningEvaluator.And and = (CombiningEvaluator.And) eval;
+            for (Evaluator e : and.evaluators) {
+                if (containsMatchText(e)) return true;
+            }
+        } else if (eval instanceof CombiningEvaluator.Or) {
+            CombiningEvaluator.Or or = (CombiningEvaluator.Or) eval;
+            for (Evaluator e : or.evaluators) {
+                if (containsMatchText(e)) return true;
+            }
+        } else if (eval instanceof StructuralEvaluator) {
+            StructuralEvaluator se = (StructuralEvaluator) eval;
+            if (se.evaluator != null && containsMatchText(se.evaluator)) return true;
+        }
+        return false;
+    }
+
+    // Replace non-blank text nodes with PseudoTextElements so they can be selected as elements
+    private static void enableMatchText(Element root) {
+        NodeTraversor.traverse(new NodeVisitor() {
+            @Override
+            public void head(Node node, int depth) {
+                if (node instanceof Element) {
+                    Element el = (Element) node;
+                    // Iterate by index as children may be replaced
+                    for (int i = 0; i < el.childNodeSize(); i++) {
+                        Node child = el.childNode(i);
+                        if (child instanceof TextNode) {
+                            TextNode tn = (TextNode) child;
+                            if (!tn.isBlank()) {
+                                PseudoTextElement pseudo = new PseudoTextElement(el.baseUri(), tn.getWholeText());
+                                tn.replaceWith(pseudo);
+                            }
+                        }
+                    }
+                }
+            }
+
+            @Override
+            public void tail(Node node, int depth) {
+                // no-op
+            }
+        }, root);
+    }
