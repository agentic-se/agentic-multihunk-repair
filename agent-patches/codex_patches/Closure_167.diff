+  private boolean isPropertyTest(Node getProp) {
+    Node parent = getProp.getParent();
+    if (parent == null) {
+      return false;
+    }
+    switch (parent.getType()) {
+      case Token.IF:
+      case Token.WHILE:
+      case Token.DO:
+      case Token.FOR:
+        return NodeUtil.getConditionExpression(parent) == getProp;
