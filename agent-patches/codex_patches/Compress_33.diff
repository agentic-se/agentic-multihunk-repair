+    public static boolean matches(byte[] signature, int length) {
+        // Need at least 2 bytes for zlib header (CMF, FLG)
+        if (length < 2) {
+            return false;
+        }
+        int cmf = signature[0] & 0xFF;
+        int flg = signature[1] & 0xFF;
+        // Compression method must be DEFLATE (8)
+        if ((cmf & 0x0F) != 8) {
+            return false;
+        }
+        // Header check: (CMF*256 + FLG) % 31 must be 0
+        int combined = (cmf << 8) | flg;
+        if (combined % 31 != 0) {
+            return false;
+        }
+        // If FDICT flag is set, a 4-byte dictionary ID follows; that is fine for detection.
+        // We intentionally only detect zlib-wrapped deflate streams here (not raw deflate).
