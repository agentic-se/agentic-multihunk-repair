@@ -400,6 +400,22 @@ public final class TypeFactory
                 }
                 newType = _fromClass(null, subclass,
                         (tb == null) ? TypeBindings.emptyBindings() : tb);
+            } else {
+                // If refinement succeeded but did not carry over bindings, try to materialize them
+                // from base type's contained types when counts match (e.g. Map<K,V> -> MyMap<K,V>).
+                if (newType.getBindings().isEmpty() && baseType.containedTypeCount() == typeParamCount) {
+                    TypeBindings tb;
+                    if (typeParamCount == 1) {
+                        tb = TypeBindings.create(subclass, baseType.containedType(0));
+                    } else if (typeParamCount == 2) {
+                        tb = TypeBindings.create(subclass, baseType.containedType(0), baseType.containedType(1));
+                    } else {
+                        tb = TypeBindings.emptyBindings();
+                    }
+                    if (!tb.isEmpty()) {
+                        newType = _fromClass(null, subclass, tb);
+                    }
+                }
             }
         } while (false);
 
