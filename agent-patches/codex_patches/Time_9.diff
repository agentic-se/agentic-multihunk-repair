@@ -279,6 +279,11 @@ public abstract class DateTimeZone implements Serializable {
      * @return the DateTimeZone object for the offset
      */
     public static DateTimeZone forOffsetMillis(int millisOffset) {
+        // Enforce maximum absolute offset of 23:59:59.999
+        if (millisOffset <= -24 * DateTimeConstants.MILLIS_PER_HOUR ||
+            millisOffset >= 24 * DateTimeConstants.MILLIS_PER_HOUR) {
+            throw new IllegalArgumentException("Millis out of range: " + millisOffset);
+        }
         String id = printOffset(millisOffset);
         return fixedOffsetZone(id, millisOffset);
     }
