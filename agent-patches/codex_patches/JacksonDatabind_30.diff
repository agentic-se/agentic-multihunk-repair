+
+        private static boolean _looksLikeIPv6Address(String v) {
+            return (v != null) && v.indexOf(':') >= 0;
+        }
+
+        private static boolean _looksLikeIPv4Address(String v) {
+            if (v == null) return false;
+            int firstDot = v.indexOf('.');
+            if (firstDot < 0) return false;
+            // Must have exactly 3 dots and only digits/dots
+            int dots = 0;
+            int len = v.length();
+            int partStart = 0;
+            for (int i = 0; i < len; ++i) {
+                char c = v.charAt(i);
+                if (c == '.') {
+                    ++dots;
+                    if (!_validIPv4Part(v, partStart, i)) return false;
+                    partStart = i + 1;
+                } else if (c < '0' || c > '9') {
+                    return false;
+                }
+            }
+            if (dots != 3) return false;
+            return _validIPv4Part(v, partStart, len);
+        }
+
+        private static boolean _validIPv4Part(String v, int start, int end) {
+            if (start >= end) return false;
+            if (end - start > 3) return false;
+            int val = 0;
+            for (int i = start; i < end; ++i) {
+                val = (val * 10) + (v.charAt(i) - '0');
+                if (val > 255) return false;
+            }
+            return true;
+        }
     }
