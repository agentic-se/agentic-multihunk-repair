+    // Consume a subquery up to the next top-level comma, correctly handling nested () and []
+    private String consumeSubQueryToComma() {
+        StringBuilder sq = new StringBuilder();
+        while (!tq.isEmpty()) {
+            if (tq.matches("(")) {
+                sq.append("(").append(tq.chompBalanced('(', ')')).append(")");
+            } else if (tq.matches("[")) {
+                sq.append("[").append(tq.chompBalanced('[', ']')).append("]");
+            } else if (tq.matches(",")) {
+                break; // reached a top-level comma separating grouped selectors
+            } else {
+                sq.append(tq.consume());
+            }
+        }
+        return sq.toString();
+    }
