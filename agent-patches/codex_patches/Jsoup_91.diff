+    // Simple heuristic to detect binary content by scanning for NULL bytes in the initial buffer
+    private static boolean looksLikeBinary(final ByteBuffer byteData) {
+        final int remaining = byteData.remaining();
+        if (remaining == 0) return false;
+
+        int nulls = 0;
+        // use absolute get to avoid modifying the buffer position
+        for (int i = 0; i < remaining; i++) {
+            if (byteData.get(i) == 0) nulls++;
+        }
+        // consider it binary if multiple NULLs present in the sampled data
+        return nulls > 3; // jpg and other binaries typically have many NULLs in first KB
+    }
