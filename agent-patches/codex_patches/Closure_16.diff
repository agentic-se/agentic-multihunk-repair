+    /**
+     * Recursively resolve aliases in a qualified type name found in JSDoc.
+     * For example, if we have aliases: b -> a.b and c -> b.c, then
+     * resolveAliasedTypeName("c.MyType") becomes "a.b.c.MyType".
+     */
+    private String resolveAliasedTypeName(String name) {
+      String current = name;
+      // Limit the number of resolutions to avoid pathological cycles.
+      int maxIterations = Math.max(1, aliases.size());
+      for (int i = 0; i < maxIterations; i++) {
+        int endIndex = current.indexOf('.');
+        if (endIndex == -1) {
+          endIndex = current.length();
+        }
+        String baseName = current.substring(0, endIndex);
+        Var aliasVar = aliases.get(baseName);
+        if (aliasVar == null) {
+          break;
+        }
+        Node aliasedNode = aliasVar.getInitialValue();
+        String aliasedQName = aliasedNode.getQualifiedName();
+        current = aliasedQName + current.substring(endIndex);
+      }
+      return current;
+    }
