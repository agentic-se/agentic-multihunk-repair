+        // When spying on abstract classes, real methods may delegate to
+        // abstract methods. Calling the real implementation of an abstract
+        // method is not possible and used to trigger a Reporter error.
+        // Instead, for abstract methods, return the default empty values
+        // consistent with Mockito's default answer semantics.
+        if (Modifier.isAbstract(invocation.getMethod().getModifiers())) {
+            return new ReturnsEmptyValues().answer(invocation);
+        }
+        return invocation.callRealMethod();
+    }
