+  /**
+   * Returns true if the given LHS node represents a direct assignment to a
+   * prototype property of the form X.prototype.Y or X.prototype[...].
+   * Does not match deeper chains like X.prototype.Y.Z.
+   */
+  private static boolean isDirectPrototypeProperty(Node lhs) {
+    // Direct assignment to the prototype object itself: X.prototype = ...
+    if (lhs.getType() == Token.GETPROP &&
+        lhs.getLastChild() != null &&
+        "prototype".equals(lhs.getLastChild().getString())) {
+      return true;
+    }
+
+    // Assignment to a direct property of the prototype: X.prototype.Y
+    if (lhs.getType() == Token.GETPROP) {
+      Node target = lhs.getFirstChild();
+      if (target != null && target.getType() == Token.GETPROP) {
+        Node last = target.getLastChild();
+        if (last != null && "prototype".equals(last.getString())) {
+          return true;
+        }
+      }
+      return false;
+    }
+
+    // Bracket form: X.prototype[...]
+    if (lhs.getType() == Token.GETELEM) {
+      Node target = lhs.getFirstChild();
+      if (target != null && target.getType() == Token.GETPROP) {
+        Node last = target.getLastChild();
+        if (last != null && "prototype".equals(last.getString())) {
+          return true;
+        }
+      }
+      return false;
+    }
+
+    return false;
+  }
