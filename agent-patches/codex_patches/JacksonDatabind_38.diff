             throw new IllegalArgumentException("Can not construct SimpleType for an array (class: "+cls.getName()+")");
         }
         return new SimpleType(cls, TypeBindings.emptyBindings(),
-                _bogusSuperClass(cls), null, null, null, false);
+                _buildSuperClassChain(cls), _buildSuperInterfaces(cls),
+                null, null, false);
     }
 
     @Override
@@ -248,6 +249,40 @@ public class SimpleType // note: until 2.6 was final
      * 
      * @since 2.7 -- remove when not needed (2.8?)
      */
+    protected static JavaType _buildSuperClassChain(Class<?> raw) {
+        Class<?> parent = raw.getSuperclass();
+        if (parent == null) {
+            return null;
+        }
+        // For java.lang.Object just use "unknown" placeholder
+        if (parent == Object.class) {
+            return TypeFactory.unknownType();
+        }
+        JavaType parentSuper = _buildSuperClassChain(parent);
+        JavaType[] parentInts = _buildSuperInterfacesArray(parent.getInterfaces());
+        return new SimpleType(parent, TypeBindings.emptyBindings(), parentSuper, parentInts,
+                null, null, false);
+    }
+
+    protected static JavaType[] _buildSuperInterfaces(Class<?> raw) {
+        Class<?>[] intfs = raw.getInterfaces();
+        return _buildSuperInterfacesArray(intfs);
+    }
+
+    private static JavaType[] _buildSuperInterfacesArray(Class<?>[] intfs) {
+        if (intfs == null || intfs.length == 0) {
+            return null;
+        }
+        JavaType[] result = new JavaType[intfs.length];
+        for (int i = 0; i < intfs.length; ++i) {
+            Class<?> iface = intfs[i];
+            JavaType superOfIface = _buildSuperClassChain(iface);
+            JavaType[] superIntfs = _buildSuperInterfacesArray(iface.getInterfaces());
+            result[i] = new SimpleType(iface, TypeBindings.emptyBindings(), superOfIface, superIntfs,
+                    null, null, false);
+        }
+        return result;
+    }
 
