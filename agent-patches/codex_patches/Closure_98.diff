+    /**
+     * Returns true if the given variable is declared syntactically within a
+     * loop structure (for/while/do) before the next function boundary.
+     * This is used to prevent inlining aliases of such variables, which
+     * could otherwise alter closure semantics across loop iterations.
+     */
+    private boolean isVarDeclaredInLoop(Var var) {
+      Node nameNode = var.getNameNode();
+      for (Node anc = nameNode.getParent(); anc != null; anc = anc.getParent()) {
+        if (NodeUtil.isLoopStructure(anc)) {
+          return true;
+        }
+        if (NodeUtil.isFunction(anc)) {
+          return false;
+        }
+      }
+      return false;
+    }
