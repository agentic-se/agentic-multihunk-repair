+            // Merge language sets for phonemes that have the same text
+            for (final Rule.Phoneme ph : subBuilder.getPhonemes()) {
+                final String text = ph.getPhonemeText().toString();
+                final Languages.LanguageSet languages = ph.getLanguages();
+                final Languages.LanguageSet existing = phonemeMap.get(text);
+                phonemeMap.put(text, existing == null ? languages : existing.merge(languages));
+            }
+        }
+
+        // Build a sorted set of phonemes from the merged map to keep deterministic ordering
+        final Set<Rule.Phoneme> phonemes = new TreeSet<Rule.Phoneme>(Rule.Phoneme.COMPARATOR);
+        for (final Map.Entry<String, Languages.LanguageSet> e : phonemeMap.entrySet()) {
+            phonemes.add(new Rule.Phoneme(e.getKey(), e.getValue()));
         }
 
         return new PhonemeBuilder(phonemes);
