+        if ((originalIsExtern ^ newIsExtern) && !"arguments".equals(name)) {
+          // One declaration is extern and the other is not; prefer the
+          // non-extern declaration in the scope so that subsequent
+          // duplicates are compared against it.
+          if (!newIsExtern) {
+            // Update scope to point at the new (source) declaration.
+            s.undeclare(v);
+            s.declare(name, n, n.getJSType(), newInput);
+          }
+          // Do not rewrite the AST for this case.
+          return;
+        }
+      }
