+  /**
+   * Unrolls a left-recursive binary operator chain and emits it iteratively
+   * using the provided operator string via addOp. This prevents deep
+   * recursion and potential StackOverflowErrors for large trees.
+   *
+   * We assume nodes are left-recursive.
+   */
+  private void unrollLeftAssociativeBinaryOperator(
+      Node n, int op, String opStr, Context context,
+      Context rhsContext, int leftPrecedence, int rightPrecedence) {
+    Node firstNonOperator = n.getFirstChild();
+    while (firstNonOperator.getType() == op) {
+      firstNonOperator = firstNonOperator.getFirstChild();
+    }
+
+    addExpr(firstNonOperator, leftPrecedence, context);
+
+    Node current = firstNonOperator;
+    do {
+      current = current.getParent();
+      cc.addOp(opStr, true);
+      addExpr(current.getFirstChild().getNext(), rightPrecedence, rhsContext);
+    } while (current != n);
+  }
