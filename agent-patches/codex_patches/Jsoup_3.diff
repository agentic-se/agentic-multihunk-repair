+    /**
+     * Parse a fragment of HTML in the context of the supplied element. This allows correct implicit parent handling
+     * for context-sensitive tags (e.g., parsing a <tr> in the context of a <table> will not create an extra <table>).
+     * The parsed nodes will be added under a temporary element with the same tag as the supplied context.
+     *
+     * @param fragmentHtml fragment of HTML to parse
+     * @param context the element that will host the parsed nodes
+     * @param baseUri base URI of document (i.e. original fetch location), for resolving relative URLs.
+     * @return an element with the same tag as the context, containing the parsed nodes as children
+     */
+    public static Element parseFragment(String fragmentHtml, Element context, String baseUri) {
+        Validate.notNull(context);
+        Parser parser = new Parser(fragmentHtml, baseUri, true);
+        // Use a temporary root matching the context tag so implicit parents are created correctly for that context.
+        Element root = new Element(context.tag(), baseUri);
+        parser.stack.clear();
+        parser.stack.add(root);
+        parser.parse();
+        return root;
+    }
