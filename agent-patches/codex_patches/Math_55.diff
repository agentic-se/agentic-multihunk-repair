+      final double aHigh = (split * a);
+      final double aTop  = aHigh - (aHigh - a);
+      final double aLow  = a - aTop;
+      final double bHigh = (split * b);
+      final double bTop  = bHigh - (bHigh - b);
+      final double bLow  = b - bTop;
+      return ((aTop * bTop - p) + aTop * bLow + aLow * bTop) + aLow * bLow;
+  }
