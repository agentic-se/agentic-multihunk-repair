+
+        /**
+         * Build {@link ExternalTypeHandler} and link type-id properties to matching
+         * creator/bean properties when available. This allows assigning external
+         * type id values to visible creator properties.
+         *
+         * @since 2.8
+         */
+        public ExternalTypeHandler build(BeanPropertyMap beanProps, SettableBeanProperty[] creatorProps) {
+            if (beanProps != null || creatorProps != null) {
+                for (ExtTypedProperty ext : _properties) {
+                    final String typePropName = ext.getTypePropertyName();
+                    SettableBeanProperty typeProp = null;
+                    if (beanProps != null) {
+                        typeProp = beanProps.find(typePropName);
+                    }
+                    if (typeProp == null && creatorProps != null) {
+                        for (SettableBeanProperty cp : creatorProps) {
+                            if (cp != null && typePropName.equals(cp.getName())) {
+                                typeProp = cp;
+                                break;
+                            }
+                        }
+                    }
+                    if (typeProp != null) {
+                        ext.linkTypeProperty(typeProp);
+                    }
+                }
+            }
+            return new ExternalTypeHandler(_properties.toArray(new ExtTypedProperty[_properties.size()]),
+                    _nameToPropertyIndex, null, null);
+        }
     }
 
     private final static class ExtTypedProperty
