+    private boolean _looksLikeIp(String s) {
+        // crude check: IPv4 digits and dots, or IPv6 hex digits and colons
+        for (int i = 0, end = s.length(); i < end; ++i) {
+            char c = s.charAt(i);
+            if ((c >= '0' && c <= '9') || c == '.' || c == ':') {
+                continue;
+            }
+            // any other char -> not an IP literal (likely a hostname)
+            return false;
+        }
+        return true;
