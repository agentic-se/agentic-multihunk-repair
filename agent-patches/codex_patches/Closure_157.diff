+  private static boolean isSimpleNumber(String s) {
+    int len = s.length();
+    if (len == 0) { return false; }
+    for (int i = 0; i < len; i++) {
+      char ch = s.charAt(i);
+      if (ch < '0' || ch > '9') {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static boolean isSafeNumberString(String s) {
+    try {
+      // Avoid overflow: if the string is too long, it may exceed Long.
+      if (s.length() > 15) {
+        // 16+ digits may exceed MAX_SAFE_INTEGER; do a manual check.
+        java.math.BigInteger bi = new java.math.BigInteger(s);
+        return bi.compareTo(java.math.BigInteger.valueOf(MAX_SAFE_INTEGER)) <= 0;
+      }
+      long v = Long.parseLong(s);
+      return Math.abs(v) <= MAX_SAFE_INTEGER;
+    } catch (NumberFormatException e) {
+      return false;
+    }
+  }
