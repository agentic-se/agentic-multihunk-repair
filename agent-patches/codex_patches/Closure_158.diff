+    // Apply warning guards. If an ordered spec is provided, honor it;
+    // otherwise fall back to applying by category.
+    if (!config.warningsGuardSpec.isEmpty()) {
+      for (String spec : config.warningsGuardSpec) {
+        if (spec == null || spec.length() < 3 || spec.charAt(1) != ':') {
+          continue; // ignore malformed entries defensively
+        }
+        char code = spec.charAt(0);
+        String name = spec.substring(2);
+        CheckLevel level;
+        switch (code) {
+          case 'e': level = CheckLevel.ERROR; break;
+          case 'w': level = CheckLevel.WARNING; break;
+          case 'o': level = CheckLevel.OFF; break;
+          default:  continue; // unknown spec code
+        }
+        diagnosticGroups.setWarningLevels(
+            options, Collections.singletonList(name), level);
+      }
+    } else {
+      diagnosticGroups.setWarningLevels(
+          options, config.jscompError, CheckLevel.ERROR);
+      diagnosticGroups.setWarningLevels(
+          options, config.jscompWarning, CheckLevel.WARNING);
+      diagnosticGroups.setWarningLevels(
+          options, config.jscompOff, CheckLevel.OFF);
+    }
 
     createDefineOrTweakReplacements(config.define, options, false);
 
