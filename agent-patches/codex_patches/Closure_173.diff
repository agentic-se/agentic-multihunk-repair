+  /**
+   * For associative binary operators, transform a op (b op c) into
+   * (a op b) op c to normalize trees to a left-deep shape. This does not
+   * change semantics for the supported operators.
+   */
+  private Node tryReassociate(Node n) {
+    if (!late) {
+      return n;
+    }
+    int opType = n.getType();
+    Node left = n.getFirstChild();
+    if (left == null) {
+      return n;
+    }
+    Node right = left.getNext();
+    if (right == null) {
+      return n;
+    }
+
+    if (right.getType() == opType && NodeUtil.isAssociative(opType)) {
+      // n: (a op (b op c))  ==>  ((a op b) op c)
+      Node a = left.detachFromParent();
+      Node b = right.removeFirstChild();
+      // Right now 'right' holds only 'c'
+      Node c = right.removeFirstChild();
+      Node newLeft = new Node(opType, a, b);
+      newLeft.copyInformationFromForTree(n);
+      // Insert the new left node before the old right child.
+      n.addChildBefore(newLeft, right);
+      // Replace the old right op node with its remaining child 'c'.
+      if (c != null) {
+        n.replaceChild(right, c);
+      } else {
+        // Should not happen, but guard against malformed trees.
+        n.removeChild(right);
+      }
+      reportCodeChange();
+    }
+    return n;
+  }
