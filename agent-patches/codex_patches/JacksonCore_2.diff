+    /**
+     * Ensure that when parsing a root-level scalar value, the following
+     * character is a valid separator (i.e. whitespace). This prevents cases
+     * like "123true" from being tokenized as two separate root values
+     * without a separator.
+     */
+    protected final void _verifyRootSpace(int ch) throws JsonParseException
+    {
+        // Only applies at root context; within arrays/objects, normal
+        // structural checks apply elsewhere.
+        if (!_parsingContext.inRoot()) {
+            return;
+        }
+        // Allow standard whitespace characters as separators between
+        // multiple root values (if caller processes multiple values).
+        if (ch == INT_SPACE || ch == INT_TAB || ch == INT_CR || ch == INT_LF) {
+            return;
+        }
+        // Otherwise, report a problem to avoid accepting mangled tokens
+        // like numbers directly followed by identifiers (e.g. true/false).
+        _reportError("expected space between root values");
+    }
     
