+          // instead of converting the assignment into a var initialization.
+          if (maybeExpr != null && maybeExpr.getType() == Token.EXPR_RESULT) {
+            canUpdateDecl = true;
+          }
+        }
+      }
+
+      if (canUpdateDecl) {
