+    /**
+     * Attempt best-effort resynchronization after a processing exception,
+     * to try to position the parser at the boundary of the current value,
+     * so that subsequent reads can continue.
+     */
+    protected void _resync() {
+        final JsonParser p = _parser;
+        if (p == null) {
+            return;
+        }
+        final JsonStreamContext seqCtxt = _seqContext;
+        if (seqCtxt == null) {
+            return;
+        }
+        try {
+            JsonToken t = p.getCurrentToken();
+            // Initialize token stream if needed
+            if (t == null) {
+                t = p.nextToken();
+            }
+            // Loop until we are back at the sequence context (container of values)
+            while (t != null && p.getParsingContext() != seqCtxt) {
+                if (t.isStructStart()) {
+                    // Skip over nested structures efficiently
+                    p.skipChildren();
+                    // After skipChildren, current token is the matching END_*; advance once
+                    t = p.getCurrentToken();
+                }
+                // Advance to next token; this may move context back towards sequence context
+                t = p.nextToken();
+            }
+        } catch (IOException ioe) {
+            // Best-effort: ignore and let caller deal with original exception
+        }
+    }
