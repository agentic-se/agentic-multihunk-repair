+    /**
+     * Returns true if aliasing the given NAME node (as an r-value) could be
+     * unsafe due to dangerous usage of the arguments object in the current
+     * function scope. Only applies to aliases of formal parameters.
+     */
+    private boolean isDangerousArgumentsUsageForAlias(NodeTraversal t, Node valueName) {
+      // Only consider when aliasing a formal parameter.
+      Var aliasedVar = t.getScope().getVar(valueName.getString());
+      if (aliasedVar == null) {
+        return false;
+      }
+      Node declParent = aliasedVar.getParentNode();
+      if (declParent == null || declParent.getType() != Token.LP) {
+        // Not a formal parameter.
+        return false;
+      }
+
+      // Find the function node for the current scope.
+      Node fn = t.getScope().getRootNode();
+      if (fn == null || fn.getType() != Token.FUNCTION) {
+        return false;
+      }
+
+      return functionHasDangerousArgumentsUsage(fn);
+    }
