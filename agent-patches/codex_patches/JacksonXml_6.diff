+    @Override
+    public int writeBinary(Base64Variant b64variant, InputStream data, int dataLength)
+            throws IOException
+    {
+        if (data == null) {
+            writeNull();
+            return 0;
+        }
+        // Reuse existing byte[] based implementation by buffering input
+        // (streaming variant is not available via Stax2 in all cases)
+        int total = 0;
+        if (dataLength >= 0) {
+            byte[] buffer = new byte[dataLength];
+            int offset = 0;
+            while (offset < dataLength) {
+                int count = data.read(buffer, offset, dataLength - offset);
+                if (count < 0) {
+                    break;
+                }
+                offset += count;
+            }
+            total = offset;
+            writeBinary(b64variant, buffer, 0, total);
+        } else {
+            ByteArrayOutputStream baos = new ByteArrayOutputStream();
+            byte[] buf = new byte[4000];
+            int count;
+            while ((count = data.read(buf)) >= 0) {
+                if (count == 0) {
+                    // avoid potential busy loop on odd streams
+                    int b = data.read();
+                    if (b < 0) {
+                        break;
+                    }
+                    baos.write(b);
+                    total += 1;
+                    continue;
+                }
+                baos.write(buf, 0, count);
+                total += count;
+            }
+            byte[] all = baos.toByteArray();
+            writeBinary(b64variant, all, 0, all.length);
+        }
+        return total;
+    }
