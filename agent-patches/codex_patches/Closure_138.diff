+  /**
+   * Returns true if the given variable name is assigned the value 'undefined'
+   * anywhere within the enclosing function of the provided node.
+   */
+  private boolean isAssignedUndefinedInEnclosingFunction(Node n, String varName) {
+    // Find the nearest enclosing function node.
+    Node cursor = n;
+    while (cursor != null && cursor.getType() != Token.FUNCTION) {
+      cursor = cursor.getParent();
+    }
+    if (cursor == null) {
+      return false;
+    }
+
+    // Scan the function subtree for simple assignments of the form
+    //   <varName> = undefined
+    // We purposefully keep this conservative and only look for direct NAME
+    // assignments to the 'undefined' identifier.
+    for (Node child = cursor.getFirstChild(); child != null; child = child.getNext()) {
+      if (isAssignedUndefinedInSubtree(child, varName)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private boolean isAssignedUndefinedInSubtree(Node root, String varName) {
+    if (root.getType() == Token.ASSIGN) {
+      Node lhs = root.getFirstChild();
+      Node rhs = root.getLastChild();
+      if (lhs.getType() == Token.NAME && varName.equals(lhs.getString())) {
+        if (rhs.getType() == Token.NAME && "undefined".equals(rhs.getString())) {
+          return true;
+        }
+      }
+    }
+    for (Node c = root.getFirstChild(); c != null; c = c.getNext()) {
+      if (isAssignedUndefinedInSubtree(c, varName)) {
+        return true;
+      }
+    }
+    return false;
+  }
