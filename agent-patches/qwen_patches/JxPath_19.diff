+    /**
+     * Determine if two element nodes are equivalent (same local name and namespace).
+     * @param node1 first node
+     * @param node2 second node
+     * @return true if nodes are equivalent
+     */
+    private static boolean areEquivalentElements(Node node1, Node node2) {
+        if (node1.getNodeType() != Node.ELEMENT_NODE || 
+            node2.getNodeType() != Node.ELEMENT_NODE) {
+            return false;
+        }
+        
+        String localName1 = DOMNodePointer.getLocalName(node1);
+        String localName2 = DOMNodePointer.getLocalName(node2);
+        String nsUri1 = DOMNodePointer.getNamespaceURI(node1);
+        String nsUri2 = DOMNodePointer.getNamespaceURI(node2);
+        
+        // Same local name and same namespace URI
+        return localName1.equals(localName2) && 
+               nsUri1 != null && nsUri2 != null && 
+               nsUri1.equals(nsUri2);
+    }
+
