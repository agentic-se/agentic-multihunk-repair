     public DateTime withHourOfDay(int hour) {
+        // Handle DST transition cases more consistently
+        // If the requested hour equals the current hour, return this instance
+        // to avoid any potentially inconsistent DST handling
+        int currentHour = getHourOfDay();
+        if (hour == currentHour) {
+            return this;
+        }
         return withMillis(getChronology().hourOfDay().set(getMillis(), hour));
     }
 
