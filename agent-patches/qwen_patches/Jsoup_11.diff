     // :not(selector)
+    private Elements not() {
+        tq.consume(":not");
+        String subQuery = tq.chompBalanced('(', ')');
+        Validate.notEmpty(subQuery, ":not(selector) subselect must not be empty");
+
+        Elements notElements = select(subQuery, root);
+        Elements result = new Elements();
+        
+        // Add elements that are NOT in the notElements set
+        for (Element element : elements) {
+            if (!notElements.contains(element)) {
+                result.add(element);
+            }
+        }
+        return result;
+    }
 
 
