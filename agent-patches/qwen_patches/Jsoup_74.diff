     /**
@@ -136,6 +136,17 @@ public class TextNode extends LeafNode {
         return text;
     }
 
+    public static String stripInvisibleCharacters(String text) {
+        if (text == null || text.isEmpty()) {
+            return text;
+        }
+        
+        // Remove common invisible Unicode characters that should not appear in plain text
+        // Soft hyphen (U+00AD), Zero Width Space (U+200B), Zero Width Non-Joiner (U+200C),
+        // Zero Width Joiner (U+200D), and non-breaking space (U+00A0)
+        return text.replaceAll("[\\u00AD\\u200B\\u200C\\u200D\\u00A0]", "");
+    }
+
     static String stripLeadingWhitespace(String text) {
         return text.replaceFirst("^\\s+", "");
     }
