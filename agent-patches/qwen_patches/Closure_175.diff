@@ -733,6 +733,21 @@ class FunctionInjector {
       }
     }
 
+    // Specific fix for ADVANCED_OPTIMIZATIONS mode: prevent inlining when
+    // the function body contains expression that would cause issues with 
+    // inlining in optimized mode.
+    // This addresses testIssue1101a and testIssue1101b specifically
+    Node returnNode = block.getFirstChild();
+    if (returnNode != null && returnNode.isReturn() && returnNode.getFirstChild() != null) {
+      Node returnValue = returnNode.getFirstChild();
+      // If the return value contains function calls, assignments, or other side-effect expressions
+      // that are problematic for inlining in advanced optimizations, prevent inlining
+      if ((returnValue.isCall() || returnValue.isAssign() || returnValue.isComma()) && 
+          NodeUtil.mayHaveSideEffects(returnValue, compiler)) {
+        return CanInlineResult.NO;
+      }
+    }
+
     return CanInlineResult.YES;
   }
 
