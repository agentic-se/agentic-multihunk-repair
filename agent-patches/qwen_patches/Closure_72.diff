+  /**
+   * Ensures label names within the inlined function are unique with respect
+   * to labels in the containing scope.
+   * @param fnNode A mutable instance of the function to be inlined.
+   */
+  private void makeLabelNamesUnique(Node fnNode) {
+    // Collect all label names in the containing scope
+    Set<String> existingLabels = new HashSet<String>();
+    collectLabelNames(fnNode, existingLabels);
+
+    // Rename labels in the function body that conflict with existing labels
+    renameConflictingLabels(fnNode, existingLabels);
+  }
+
+  /**
+   * Recursively collect all label names in the node tree.
+   */
+  private void collectLabelNames(Node node, Set<String> labelNames) {
+    if (node.getType() == Token.LABEL_NAME) {
+      labelNames.add(node.getString());
+    }
+
+    for (Node child = node.getFirstChild(); child != null; child = child.getNext()) {
+      collectLabelNames(child, labelNames);
+    }
+  }
+
+  /**
+   * Rename labels that conflict with existing label names in the containing scope.
+   */
+  private void renameConflictingLabels(Node node, Set<String> existingLabels) {
+    Supplier<String> idSupplier = compiler.getUniqueNameIdSupplier();
+    if (node.getType() == Token.LABEL_NAME) {
+      String labelName = node.getString();
+      if (existingLabels.contains(labelName)) {
+        // Generate a new unique label name
+        String newName = "JSCompiler_inline_label_" + idSupplier.get();
+        node.setString(newName);
+      }
+    }
+
+    for (Node child = node.getFirstChild(); child != null; child = child.getNext()) {
+      renameConflictingLabels(child, existingLabels);
+    }
   }
 
